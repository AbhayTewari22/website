---
import '../styles/global.css';
interface Props { title: string; description?: string; wide?: boolean; noindex?: boolean; }
const { title, description = 'Abhay Tewari — writing, courses and tools on insurance, reinsurance, investing and applied AI.', wide = false, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/blog/', 'Articles'], ['/stories/', 'Stories'], ['/courses/', 'Courses'], ['/tools/', 'Tools'], ['/about/', 'About'],
];
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const canonical = new URL(path, Astro.site ?? 'https://abhaytewari.com').href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title === 'Abhay Tewari' ? title : `${title} · Abhay Tewari`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Abhay Tewari — Articles" href="/rss.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/vendor/katex.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
  </script>
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/"><span class="sigil">AT</span>Abhay Tewari</a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav" id="navToggle">Menu</button>
      <nav class="nav" id="nav" aria-label="Primary">
        {nav.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
        <a href="#" id="themeToggle" title="Toggle light/dark" aria-label="Toggle theme">◐</a>
      </nav>
    </div>
  </header>
  <main class={wide ? '' : 'wrap'}>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div>© {new Date().getFullYear()} Abhay Tewari · Navi Mumbai. Views are personal; nothing here is investment, actuarial or legal advice.</div>
      <div><a href="/rss.xml">RSS</a> · <a href="/about/#contact">Contact</a> · <a href="https://www.linkedin.com/in/abhaytewari" rel="me noopener">LinkedIn</a></div>
    </div>
  </footer>
  <script is:inline>
    const tgl = document.getElementById('navToggle'), nav = document.getElementById('nav');
    tgl && tgl.addEventListener('click', () => { const o = nav.classList.toggle('open'); tgl.setAttribute('aria-expanded', String(o)); });
    const th = document.getElementById('themeToggle');
    th && th.addEventListener('click', (e) => { e.preventDefault();
      const cur = document.documentElement.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = cur === 'dark' ? 'light' : 'dark'; document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (err) {} });
  </script>
</body>
</html>
