---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', p => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const stories = (await getCollection('stories', p => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const courses = (await getCollection('courses')).slice(0, 3);
---
<Base title="Abhay Tewari">
  <section class="hero">
    <div>
      <div class="eyebrow">Actuary · Insurance CEO · Investor · Researcher in applied AI</div>
      <h1>Pricing risk, managing capital, and writing about both.</h1>
      <p class="lede">Notes from twenty-eight years across insurance, reinsurance, investments and actuarial science, and from a doctoral research programme on generative AI for catastrophe risk. Articles, stories, courses, and working tools you can run in your browser.</p>
      <p><a class="btn" href="/tools/">Try the tools</a> &nbsp; <a class="btn ghost" href="/blog/">Read the articles</a></p>
    </div>
    <aside class="hero-card">
      <div class="eyebrow">Currently</div>
      <dl>
        <dt>Role</dt><dd>MD &amp; CEO, Star Union Dai-ichi Life Insurance</dd>
        <dt>Research</dt><dd>WGAN + EVT catastrophe pricing; ML for insurer investment returns</dd>
        <dt>Building</dt><dd>Gift Re (AI-native reinsurer), ZENOJAS (investment process)</dd>
        <dt>Credentials</dt><dd>CFA · FIA (UK) · FIAI</dd>
      </dl>
    </aside>
  </section>

  <section class="section">
    <div class="section-head"><h2>Tools</h2><a href="/tools/">All tools →</a></div>
    <div class="grid">
      <article class="card tool"><div class="meta"><span>Reinsurance · Generative AI</span></div><h3><a href="/tools/pricing-lab/">Catastrophe pricing lab (W-GAN + EVT)</a></h3><p>Price catastrophe excess-of-loss layers for Indian flood, cyclone, earthquake and drought. A Wasserstein GAN generates scenarios, Extreme Value Theory anchors the tail, and an RBC-style capital charge sets the premium. Runs entirely in your browser. The W-GAN models were trained with AI assistance (Claude) and are documented in the <a href="/blog/pricing-catastrophes-with-wgan-and-evt/">blog post on the method</a>.</p><p><a class="btn" href="/tools/pricing-lab/">Open the pricing lab</a></p></article>
      <article class="card tool"><div class="meta"><span>Investing · Business cycle</span></div><h3><a href="/tools/cycle-compass/">Cycle Compass</a></h3><p>Score the lead, coincident and lag indicators for India and the US, get a phase reading with a confidence level, and see the sector tilts and NSE ETF menu the rulebook prescribes for that phase.</p></article>
      <article class="card tool"><div class="meta"><span>Investing · Machine learning</span></div><h3><a href="/tools/zenojas/">ZENOJAS Stock Model</a></h3><p>Quarterly XGBoost scores for ~940 NSE stocks (the first-choice model, replacing the earlier BiLSTM), a 21-quarter out-of-sample backtest against the NIFTY 50, and in-sample, net-of-cost and factor checks shown as plainly as the returns.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Latest articles</h2><a href="/blog/">All articles →</a></div>
    <div class="grid">{posts.map(p => <PostCard href={`/blog/${p.id}/`} title={p.data.title} description={p.data.description} date={p.data.date} tags={p.data.tags} />)}</div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Courses</h2><a href="/courses/">All courses →</a></div>
    <div class="grid">{courses.map(c => <article class="card"><div class="meta"><span class={`pill ${c.data.status === 'open' ? 'open' : 'soon'}`}>{c.data.status === 'open' ? 'Enrolling' : 'Coming soon'}</span><span>{c.data.level} · {c.data.duration}</span></div><h3><a href={`/courses/${c.id}/`}>{c.data.title}</a></h3><p>{c.data.description}</p></article>)}</div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Stories &amp; essays</h2><a href="/stories/">All stories →</a></div>
    <div class="grid">{stories.map(s => <PostCard href={`/stories/${s.id}/`} title={s.data.title} description={s.data.description} date={s.data.date} kind={s.data.kind} />)}</div>
  </section>
</Base>
