    { const el = $('cMcap'), W = 520, H = 200, m = { l: 70, r: 60, t: 16, b: 10 }, bands = D.mcap_exposure; const rh = (H - m.t - m.b) / bands.length; const xs = v => m.l + (W - m.l - m.r) * v; let g = '';
      bands.forEach((b, i) => { const y = m.t + i * rh; g += `<text x="${m.l - 8}" y="${y + rh / 2 + 4}" text-anchor="end">${b.band}</text><rect x="${m.l}" y="${y + 6}" width="${xs(b.portfolio) - m.l}" height="${rh / 2 - 8}" rx="2" fill="${css('--accent')}"/><text x="${xs(b.portfolio) + 5}" y="${y + rh / 4 + 6}">${pct(b.portfolio, 0)}</text><rect x="${m.l}" y="${y + rh / 2 + 2}" width="${xs(b.universe) - m.l}" height="${rh / 2 - 8}" rx="2" fill="${css('--ink-3')}"/><text x="${xs(b.universe) + 5}" y="${y + 3 * rh / 4 + 2}">${pct(b.universe, 0)}</text>`; });
