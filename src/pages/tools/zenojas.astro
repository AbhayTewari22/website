---
import Base from '../../layouts/Base.astro';
import ZenojasNav from '../../components/ZenojasNav.astro';
import { Content as ModelCard } from '../../data/zenojas-model-card.md';
---
<Base title="ZENOJAS Stock Model" description="ZENOJAS XGBoost v2: quarterly stock-selection scores for ~940 NSE stocks, a 21-quarter out-of-sample backtest against the NIFTY 50, in-sample vs out-of-sample and net-of-cost checks, and candid caveats.">
  <style is:global>
    .zn { display: grid; gap: 22px; }
    .zn-head { padding-block: 40px 8px; max-width: 72ch; }
    .zn-stamp { font-family: var(--font-mono); font-size: .85rem; color: var(--ink-3); }
    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
    .kpi { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; }
    .kpi .eyebrow { margin-bottom: 4px; }
    .kpi .v { font-family: var(--font-mono); font-size: 1.5rem; font-variant-numeric: tabular-nums; line-height: 1.1; }
    .kpi .u { color: var(--ink-3); font-size: .8rem; margin-top: 3px; }
    .kpi.primary { border-color: var(--accent); }
    .kpi.primary .v { color: var(--accent); }
    .panel { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; box-shadow: var(--shadow); min-width: 0; }
    .panel h2 { font-size: 1.3rem; margin-bottom: 6px; }
    .panel h2 small { font-family: var(--font-body); font-size: .8rem; color: var(--ink-3); font-weight: 400; margin-left: 8px; }
    .zn-tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--line); }
    .zn-tabs button { border: none; background: none; font: inherit; font-weight: 500; color: var(--ink-2); padding: 8px 12px; border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer; }
    .zn-tabs button[aria-selected="true"] { color: var(--accent); border-bottom-color: var(--accent); }
    .tabpanel { padding-top: 16px; display: grid; gap: 18px; }
    .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 22px; }
    .chart { width: 100%; height: auto; display: block; }
    .chart text { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-2); }
    .chart .grid line { stroke: var(--line); }
    .chart .axis { stroke: var(--ink-3); }
    .legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: .85rem; color: var(--ink-2); margin-top: 6px; }
    .legend i { display: inline-block; width: 12px; height: 3px; margin-right: 6px; vertical-align: middle; border-radius: 2px; }
    table.zt { border-collapse: collapse; width: 100%; font-size: .9rem; }
    .zt th, .zt td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
    .zt th { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-3); position: sticky; top: 0; background: var(--panel); cursor: pointer; }
    .zt td.n, .zt th.n { text-align: right; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
    .zt td.name { white-space: normal; min-width: 180px; }
    .tablewrap { overflow: auto; max-height: 560px; border: 1px solid var(--line); border-radius: 8px; }
    .controls { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 10px; }
    .controls input, .controls select { font: inherit; font-size: .9rem; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-2); color: var(--ink); }
    .controls .count { font-size: .85rem; color: var(--ink-3); margin-left: auto; }
    .band { display: inline-block; font-size: .7rem; padding: 1px 7px; border-radius: 999px; font-weight: 600; letter-spacing: .03em; background: var(--bg-2); color: var(--ink-2); }
    .band.Large { background: var(--accent-soft); color: var(--accent); }
    .score { display: inline-block; height: 8px; border-radius: 4px; background: var(--accent); vertical-align: middle; margin-right: 6px; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px 16px; font-size: .9rem; }
    .stats div { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px dotted var(--line); padding: 4px 0; }
    .stats b { font-family: var(--font-mono); font-weight: 500; }
    .warn { background: color-mix(in srgb, var(--mark) 14%, transparent); border-left: 3px solid var(--mark); padding: 10px 14px; border-radius: 6px; font-size: .95rem; color: var(--ink-2); }
    .prose-sm { font-size: .95rem; max-width: 72ch; }
    .hl-controls { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; }
    .hl-controls label { font-size: .85rem; color: var(--ink-2); display: flex; gap: 6px; align-items: center; }
    .hl-controls select { font: inherit; font-size: .9rem; padding: 5px 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-2); color: var(--ink); }
    .hl-period { font-family: var(--font-mono); font-size: .8rem; color: var(--ink-3); }
    .kpi.insample { border-color: #C98500; }
    .prose-sm p { margin-bottom: .8em; }
  </style>

  <div class="zn">
    <header class="zn-head">
      <div class="eyebrow">Tool · Machine-learning stock selection</div>
      <h1>ZENOJAS Stock Model</h1>
      <p class="lede" style="color:var(--ink-2)">A shallow, regularised XGBoost model (now the first-choice ZENOJAS ranker, replacing the earlier BiLSTM) scores every stock in a ~940-name NSE universe each quarter with the probability that its next-quarter return ranks in the top 200. The 30 highest-probability names form an equal-weight portfolio. Everything on this page is a published model output; the model itself runs offline. New to this? Start with <a href="/tools/zenojas/how-it-works/">How it works</a>; the technical detail is in the <a href="/tools/zenojas/playbook/">Playbook</a>.</p>
      <ZenojasNav current="model" />
      <p style="font-size:.9rem;margin:6px 0 0">Also in this research programme: <a href="/tools/pricing-lab/">Catastrophe pricing lab (W-GAN + EVT) →</a></p>
      <div class="zn-stamp" id="stamp">loading model outputs…</div>
    </header>

    <div class="panel" style="padding:14px 18px">
      <div class="hl-controls">
        <span class="eyebrow">XGBoost backtest window</span>
        <label>Start quarter <select id="hl-start"></select></label>
        <label>Quarters <select id="hl-n"><option>8</option><option>12</option><option>15</option><option>16</option><option>17</option><option>20</option><option selected>21</option><option>24</option></select></label>
        <label>Portfolio <select id="hl-size"><option value="25">Top 25</option><option value="30" selected>Top 30</option><option value="50">Top 50</option></select></label>
        <span class="hl-period" id="hl-period"></span>
        <a href="/tools/zenojas/explorer/" style="margin-left:auto;font-size:.85rem">Full Explorer →</a>
      </div>
      <div class="warn" id="hl-warn" hidden style="margin:10px 0"></div>
      <div class="kpis" id="headline" style="margin-top:12px"></div>
    </div>

    <div class="panel">
      <h2>Does it hold up?<small>out-of-sample 21 quarters, Mar-2021 → Mar-2026, top 30, equal weight</small></h2>
      <div class="two">
        <div>
          <h3 style="font-size:1rem">In-sample vs out-of-sample</h3>
          <div class="tablewrap" style="max-height:none"><table class="zt">
            <thead><tr><th>Model</th><th>Window</th><th class="n">CAGR</th><th class="n">Rank IC</th><th class="n">Precision@30</th></tr></thead>
            <tbody>
              <tr><td><b>XGBoost</b></td><td>In-sample 2005–20</td><td class="n">60.4%</td><td class="n">0.091</td><td class="n">0.80</td></tr>
              <tr><td><b>XGBoost</b></td><td>Out-of-sample 2021–26</td><td class="n">64.9%</td><td class="n">0.098</td><td class="n">0.68</td></tr>
              <tr><td>BiLSTM v1</td><td>In-sample 2005–20</td><td class="n">129.4%</td><td class="n">0.246</td><td class="n">0.60</td></tr>
              <tr><td>BiLSTM v1</td><td>Out-of-sample 2021–26</td><td class="n">36.4%</td><td class="n">0.009</td><td class="n">0.34</td></tr>
            </tbody>
          </table></div>
          <p style="font-size:.85rem;color:var(--ink-2);margin-top:8px">XGBoost shows no decay out of sample. The BiLSTM's in-sample fit collapses: its ticker embedding memorised which stocks did well in 2005–2020.</p>
        </div>
        <div>
          <h3 style="font-size:1rem">Net of costs</h3>
          <div class="tablewrap" style="max-height:none"><table class="zt">
            <thead><tr><th>Model</th><th class="n">Turnover / q</th><th class="n">Gross</th><th class="n">50 bp / side</th><th class="n">100 bp / side</th></tr></thead>
            <tbody>
              <tr><td><b>XGBoost</b></td><td class="n">61%</td><td class="n">64.9%</td><td class="n">61.3%</td><td class="n">57.7%</td></tr>
              <tr><td>BiLSTM v1</td><td class="n">44%</td><td class="n">36.4%</td><td class="n">34.1%</td><td class="n">31.9%</td></tr>
            </tbody>
          </table></div>
          <p style="font-size:.85rem;color:var(--ink-2);margin-top:8px">CAGR. Comparators (gross): Logistic 64.2%, LightGBM 61.9%, Random Forest 59.3%, universe equal-weight 25.5%, random ranking 24.4%, momentum rank 15.4%, NIFTY 50 8.6%.</p>
        </div>
      </div>
      <div class="stats" style="margin-top:12px">
        <div><span>Sharpe / Sortino</span><b>1.90 / 5.8</b></div>
        <div><span>Max drawdown</span><b>−22.0%</b></div>
        <div><span>Beta vs NIFTY 50</span><b>1.53</b></div>
        <div><span>Five-factor alpha</span><b>30.6% (t 2.44)</b></div>
        <div><span>Size beta</span><b>1.25</b></div>
        <div><span>vs BiLSTM, per quarter</span><b>+5.5% (t 4.26)</b></div>
        <div><span>CAGR gap, 95% CI</span><b>14.5–45.5 pp</b></div>
        <div><span>Deflated Sharpe (15 trials)</span><b>0.994</b></div>
      </div>
      <div class="warn" style="margin-top:14px">Caveats: a walk-forward re-test (re-trained every quarter) gives about 62% a year for 2021–26, but the tabular models are statistically tied and most of the edge is 12-month momentum. The training label refers to the quarter just ended, so precision@30 overstates skill. Returns are a backtest, gross unless stated, on a survivors-only universe, so compare with the equal-weight universe rather than the NIFTY 50. The book has high beta and a strong small/mid-cap tilt (much of the return is size, not selection). Not investment advice. Full detail in the <a href="#" data-goto="card">model card</a>.</div>
    </div>

    <div class="warn">The portfolio, ranked universe, backtest and diagnostics tabs below come from the <b>earlier BiLSTM v1 scoring run</b> (outputs file not yet regenerated). XGBoost picks will replace them after the next scoring run; until then, read them as the superseded model's output.</div>

    <div>
      <div class="eyebrow" style="margin-bottom:8px">Latest scoring run (BiLSTM v1) · signal quality</div>
      <div class="kpis" id="kpis"></div>
    </div>

    <div class="panel">
      <div class="zn-tabs" role="tablist" id="tabs">
        <button role="tab" aria-selected="true" data-tab="portfolio">Portfolio (BiLSTM v1)</button>
        <button role="tab" aria-selected="false" data-tab="universe">Ranked universe</button>
        <button role="tab" aria-selected="false" data-tab="backtest">Backtest</button>
        <button role="tab" aria-selected="false" data-tab="diag">Diagnostics</button>
        <button role="tab" aria-selected="false" data-tab="card">Model card</button>
      </div>

      <div class="tabpanel" id="tab-portfolio">
        <div class="two">
          <div><h2>The 25 names (BiLSTM v1)<small id="asof"></small></h2><div class="tablewrap" style="max-height:620px"><table class="zt" id="ptable"></table></div></div>
          <div>
            <h2>Size exposure vs universe</h2>
            <svg class="chart" id="cMcap" viewBox="0 0 520 200" role="img" aria-label="Portfolio market-cap band exposure versus universe"></svg>
            <div class="legend"><span><i style="background:var(--accent)"></i>Portfolio</span><span><i style="background:var(--ink-3)"></i>Universe</span></div>
            <div class="warn" style="margin-top:14px" id="pnote"></div>
          </div>
        </div>
      </div>

      <div class="tabpanel" id="tab-universe" hidden>
        <div class="controls">
          <input id="q" type="search" placeholder="Search ticker or name" aria-label="Search">
          <select id="fband" aria-label="Market-cap band"><option value="">All bands</option><option>Large</option><option>Mid</option><option>Small</option></select>
          <select id="fdec" aria-label="Decile"><option value="">All deciles</option><option value="1">Decile 1 (top)</option><option value="2">Decile 2</option><option value="3">Decile 3</option><option value="10">Decile 10 (bottom)</option></select>
          <label style="font-size:.85rem;color:var(--ink-2)"><input type="checkbox" id="fimp"> hide imputed</label>
          <span class="count" id="count"></span>
        </div>
        <div class="tablewrap"><table class="zt" id="utable"></table></div>
        <p style="font-size:.8rem;color:var(--ink-3)">Click a column header to sort. "Imputed" marks stocks with at least one missing input filled with the universe median. Market-cap bands: top 100 by rank = Large, 101–250 = Mid, rest = Small.</p>
      </div>

      <div class="tabpanel" id="tab-backtest" hidden>
        <div class="two">
          <div>
            <h2>Growth of 100<small id="btperiod"></small></h2>
            <svg class="chart" id="cEq" viewBox="0 0 640 300" role="img" aria-label="Equity curve of strategy, NIFTY Midcap 100, NIFTY 50 and equal-weight universe"></svg>
            <div class="legend"><span><i style="background:var(--accent)"></i>Top-25 strategy</span><span><i style="background:var(--mark)"></i>NIFTY Midcap 100</span><span><i style="background:var(--ok)"></i>NIFTY 50</span><span><i style="background:var(--ink-3)"></i>Universe equal-weight</span><span><i style="background:var(--line);height:10px"></i>Live (out-of-time) quarters</span></div>
          </div>
          <div>
            <h2>Statistics</h2>
            <div class="stats" id="stats"></div>
            <h3 style="margin-top:16px;font-size:1rem">Alpha and beta</h3>
            <div class="tablewrap"><table class="zt" id="abtable"></table></div>
            <h3 style="margin-top:16px;font-size:1rem">Quarterly returns</h3>
            <div class="tablewrap" style="max-height:300px"><table class="zt" id="qtable"></table></div>
          </div>
        </div>
        <div class="warn" id="btnote"></div>
        <p style="font-size:.9rem;color:var(--ink-2)">This tab shows the earlier BiLSTM v1 scoring run's 14-quarter series against the NIFTY Midcap 100. For any window from 2005 to 2025, other portfolio sizes and factor-index benchmarks, use the <a href="/tools/zenojas/explorer/">Backtest Explorer</a>.</p>
      </div>

      <div class="tabpanel" id="tab-diag" hidden>
        <div class="two">
          <div><h2>Rank IC by quarter<small>Spearman correlation of score with next-quarter return</small></h2><svg class="chart" id="cIC" viewBox="0 0 640 220" role="img" aria-label="Rank information coefficient by quarter"></svg></div>
          <div><h2>Annualised return by score decile<small>D1 = highest scores</small></h2><svg class="chart" id="cDec" viewBox="0 0 640 220" role="img" aria-label="Annualised return by score decile"></svg></div>
          <div><h2>Feature importance<small>AUC drop when the feature is permuted</small></h2><svg class="chart" id="cFeat" viewBox="0 0 640 300" role="img" aria-label="Permutation feature importance"></svg></div>
          <div><h2>Classification quality</h2><div class="stats" id="cls"></div><div class="warn" style="margin-top:14px" id="dnote"></div></div>
        </div>
      </div>

      <div class="tabpanel" id="tab-card" hidden>
        <article class="prose prose-sm"><ModelCard /></article>
      </div>
    </div>

    <article class="card tool"><div class="meta"><span>Also from this research programme · Reinsurance · Generative AI · EVT</span></div><h3><a href="/tools/pricing-lab/">Catastrophe pricing lab (W-GAN + EVT)</a></h3><p>Price catastrophe excess-of-loss layers for Indian flood, cyclone, earthquake and drought: a conditional Wasserstein GAN generates loss scenarios, a Generalized Pareto tail anchors the extremes, and an RBC-style capital charge sets the premium. The W-GAN models were trained with AI assistance (Claude) and are documented in the <a href="/blog/pricing-catastrophes-with-wgan-and-evt/">blog post on the method</a>.</p><p><a class="btn" href="/tools/pricing-lab/">Open the pricing lab</a></p></article>

    <p class="notice">Research output, not investment advice. The author is not a SEBI-registered investment adviser. Scores and portfolios are model artefacts with the limitations stated in the diagnostics and model card; past backtest performance does not predict future results.</p>
  </div>

  <script is:inline>
  const $ = id => document.getElementById(id);
  const css = v => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
  const pct = (x, d = 1) => x == null ? '–' : (100 * x).toFixed(d) + '%';
  const num = (x, d = 0) => x == null ? '–' : x.toLocaleString('en-IN', { maximumFractionDigits: d, minimumFractionDigits: d });
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  function svgLine(el, series, opts) {
    const W = 640, H = +el.getAttribute('viewBox').split(' ')[3], m = { l: 48, r: 14, t: 14, b: 34 };
    const n = series[0].data.length, xs = i => m.l + (W - m.l - m.r) * i / (n - 1);
    const all = series.flatMap(s => s.data); const lo = Math.min(...all) * 0.95, hi = Math.max(...all) * 1.04;
    const ys = v => m.t + (H - m.t - m.b) * (1 - (v - lo) / (hi - lo));
    let g = '<g class="grid">';
    const ticks = 5; for (let k = 0; k <= ticks; k++) { const v = lo + (hi - lo) * k / ticks, y = ys(v); g += `<line x1="${m.l}" x2="${W - m.r}" y1="${y}" y2="${y}"/><text x="${m.l - 6}" y="${y + 4}" text-anchor="end">${v.toFixed(0)}</text>`; }
    g += '</g>';
    if (opts.shade) { const a = opts.shade[0], b = opts.shade[1]; g += `<rect x="${xs(a)}" y="${m.t}" width="${xs(b) - xs(a)}" height="${H - m.t - m.b}" fill="${css('--line')}" opacity=".5"/>`; }
    for (const s of series) g += `<path d="${s.data.map((v, i) => (i ? 'L' : 'M') + xs(i).toFixed(1) + ' ' + ys(v).toFixed(1)).join(' ')}" fill="none" stroke="${s.color}" stroke-width="${s.width || 2}" stroke-dasharray="${s.dash || ''}"/>`;
    for (const s of series) { const i = n - 1; g += `<circle cx="${xs(i)}" cy="${ys(s.data[i])}" r="3" fill="${s.color}"/><text x="${xs(i) - 4}" y="${ys(s.data[i]) - 7}" text-anchor="end" fill="${s.color}">${s.data[i].toFixed(0)}</text>`; }
    opts.labels.forEach((l, i) => { if (i % opts.every === 0 || i === n - 1) g += `<text x="${xs(i)}" y="${H - 12}" text-anchor="middle">${l}</text>`; });
    el.innerHTML = g;
  }
  function svgBars(el, items, opts = {}) {
    const W = 640, H = +el.getAttribute('viewBox').split(' ')[3], m = { l: opts.horizontal ? 150 : 48, r: 14, t: 12, b: 30 };
    const vals = items.map(x => x[1]); const lo = Math.min(0, ...vals), hi = Math.max(0, ...vals) || 1;
    let g = '';
    if (opts.horizontal) {
      const bh = (H - m.t - m.b) / items.length; const xs = v => m.l + (W - m.l - m.r) * (v - lo) / (hi - lo);
      g += `<line class="axis" x1="${xs(0)}" x2="${xs(0)}" y1="${m.t}" y2="${H - m.b}"/>`;
      items.forEach((it, i) => { const y = m.t + i * bh + 3, x0 = xs(Math.min(0, it[1])), w = Math.abs(xs(it[1]) - xs(0)); g += `<rect x="${x0}" y="${y}" width="${w}" height="${bh - 6}" rx="2" fill="${it[1] >= 0 ? css('--accent') : css('--mark')}"/><text x="${m.l - 8}" y="${y + bh / 2 + 1}" text-anchor="end">${esc(it[0])}</text><text x="${(it[1] >= 0 ? xs(it[1]) + 5 : x0 - 5)}" y="${y + bh / 2 + 1}" text-anchor="${it[1] >= 0 ? 'start' : 'end'}">${opts.fmt(it[1])}</text>`; });
    } else {
      const bw = (W - m.l - m.r) / items.length; const ys = v => m.t + (H - m.t - m.b) * (1 - (v - lo) / (hi - lo));
      g += `<line class="axis" x1="${m.l}" x2="${W - m.r}" y1="${ys(0)}" y2="${ys(0)}"/>`;
      if (opts.ref != null) g += `<line x1="${m.l}" x2="${W - m.r}" y1="${ys(opts.ref)}" y2="${ys(opts.ref)}" stroke="${css('--ink-3')}" stroke-dasharray="4 3"/><text x="${W - m.r}" y="${ys(opts.ref) - 4}" text-anchor="end">${opts.refLabel}</text>`;
      items.forEach((it, i) => { const x = m.l + i * bw + 4, y0 = ys(Math.max(0, it[1])), h = Math.abs(ys(it[1]) - ys(0)); g += `<rect x="${x}" y="${y0}" width="${bw - 8}" height="${h}" rx="2" fill="${it[1] >= 0 ? css('--accent') : css('--mark')}"/><text x="${x + (bw - 8) / 2}" y="${H - 10}" text-anchor="middle">${esc(it[0])}</text><text x="${x + (bw - 8) / 2}" y="${it[1] >= 0 ? y0 - 4 : y0 + h + 12}" text-anchor="middle">${opts.fmt(it[1])}</text>`; });
    }
    el.innerHTML = g;
  }

  let D = null, sortKey = 'rank', sortDir = 1;
  function renderUniverse() {
    const q = $('q').value.trim().toLowerCase(), band = $('fband').value, dec = $('fdec').value, hideImp = $('fimp').checked;
    let rows = D.rankings.filter(r => (!q || r.ticker.toLowerCase().includes(q) || (r.name || '').toLowerCase().includes(q)) && (!band || r.mcap_band === band) && (!dec || String(r.decile) === dec) && !(hideImp && r.imputed));
    rows.sort((a, b) => { const va = a[sortKey], vb = b[sortKey]; if (va == null) return 1; if (vb == null) return -1; return (va > vb ? 1 : va < vb ? -1 : 0) * sortDir; });
    $('count').textContent = `${rows.length} of ${D.rankings.length} stocks`;
    const cols = [['rank', 'Rank', 'n'], ['ticker', 'Ticker', ''], ['name', 'Company', 'name'], ['mcap_band', 'Band', ''], ['mcap_inr_cr', 'Mkt cap ₹ cr', 'n'], ['score', 'Score', 'n'], ['decile', 'Decile', 'n'], ['imputed', 'Imputed', '']];
    $('utable').innerHTML = '<thead><tr>' + cols.map(c => `<th class="${c[2] === 'n' ? 'n' : ''}" data-k="${c[0]}">${c[1]}${sortKey === c[0] ? (sortDir > 0 ? ' ▲' : ' ▼') : ''}</th>`).join('') + '</tr></thead><tbody>' +
      rows.slice(0, 400).map(r => `<tr><td class="n">${r.rank}</td><td class="mono">${esc(r.ticker)}</td><td class="name">${esc(r.name)}</td><td>${r.mcap_band ? `<span class="band ${r.mcap_band}">${r.mcap_band}</span>` : '–'}</td><td class="n">${num(r.mcap_inr_cr)}</td><td class="n"><span class="score" style="width:${Math.round(60 * r.score)}px"></span>${r.score.toFixed(3)}</td><td class="n">${r.decile}</td><td>${r.imputed ? 'yes' : ''}</td></tr>`).join('') + (rows.length > 400 ? `<tr><td colspan="8" style="color:var(--ink-3)">Showing the first 400; narrow the search to see the rest.</td></tr>` : '') + '</tbody>';
