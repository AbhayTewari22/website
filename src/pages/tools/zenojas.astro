  }

  document.querySelectorAll('[data-goto]').forEach(a => a.onclick = e => { e.preventDefault(); const b = $('tabs').querySelector(`[data-tab="${a.dataset.goto}"]`); b && b.click(); $('tabs').scrollIntoView({ behavior: 'smooth' }); });
  $('tabs').querySelectorAll('button').forEach(b => b.onclick = () => { $('tabs').querySelectorAll('button').forEach(x => x.setAttribute('aria-selected', x === b)); document.querySelectorAll('.zn .tabpanel').forEach(p => p.hidden = p.id !== 'tab-' + b.dataset.tab); });
  ['q', 'fband', 'fdec', 'fimp'].forEach(id => $(id).addEventListener('input', () => D && renderUniverse()));
  fetch('/apps/zenojas/outputs.json').then(r => r.json()).then(d => { D = d; render(); }).catch(e => { $('stamp').textContent = 'Could not load model outputs (' + e.message + ').'; });

  // Headline: any window of the XGBoost series (first-choice model), computed from the same file the Backtest Explorer uses.
  let HB = null; const HEAD = 'xgboost';
  function renderHeadline() {
    const B = HB, RF = B.meta.risk_free ?? 0.065, HM = B.models[HEAD] || B.models.bilstm, cut = HM.training_through || B.meta.training_through;
    const size = 'top' + $('hl-size').value, want = +$('hl-n').value, startIdx = +$('hl-start').value;
    const sMap = Object.fromEntries(HM.series.map(s => [s.date, s]));
    const rows = B.quarters.slice(startIdx, startIdx + want).filter(q => sMap[q.date] && sMap[q.date][size] != null);
    const n = rows.length; if (n < 2) { $('headline').innerHTML = ''; return; }
    const yrs = n / 4, r = rows.map(q => sMap[q.date][size]), u = rows.map(q => q.universe_ew), bAll = rows.map(q => q.benchmarks?.nifty50), benchOK = bAll.every(v => v != null), b = benchOK ? bAll : null;
    const mean = a => a.reduce((s, x) => s + x, 0) / a.length, sd = a => { const m = mean(a); return Math.sqrt(a.reduce((s, x) => s + (x - m) ** 2, 0) / (a.length - 1)); };
