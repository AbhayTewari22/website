      ['Alpha (annual)', b ? pct(alpha) : '–', b ? `beta ${beta.toFixed(2)} · t-stat ${t.toFixed(1)}` : ''], ['Sharpe', sharpe.toFixed(2), `vol ${pct(vol, 0)} · rf ${pct(RF)}`], ['Max drawdown', pct(mdd), 'peak to trough, quarterly'], ['Information ratio', b ? ir.toFixed(2) : '–', b ? `excess return ÷ tracking error, vs NIFTY 50` : ''], ['Tracking error', b ? pct(te) : '–', 'annualised sd of quarterly excess return'], ['Hit rate vs NIFTY 50', b ? pct(hit, 0) : '–', `${n} quarters`],
    ].map(k => `<div class="kpi ${k[3] || ''} ${cls}"><div class="eyebrow">${k[0]}</div><div class="v">${k[1]}</div><div class="u">${esc(k[2])}</div></div>`).join('');
