---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog', p => !p.data.draft);
  return posts.map(p => ({ params: { id: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <header class="article-head">
    <div class="eyebrow">Article</div>
    <h1>{post.data.title}</h1>
    <p class="lede" style="color:var(--ink-2)">{post.data.description}</p>
    <div class="meta"><time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>{post.data.readingTime && <span>{post.data.readingTime}</span>}<span>Abhay Tewari</span></div>
    <div class="tags" style="margin-top:10px">{post.data.tags.map(t => <span class="tag">{t}</span>)}</div>
  </header>
  <article class="prose"><Content /></article>
  <p style="margin-top:40px"><a href="/blog/">← All articles</a></p>
</Base>
